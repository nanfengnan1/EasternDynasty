{
  "name": "design_general_card",
  "description": "根据人物设定、图片参考和视觉规范生成或修改武将卡片/纯立绘；返回真实产物、使用的提示词和验收结果。此文件是工具契约，需由宿主接入实际图像生成工具。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "General character illustration / card request",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "enum": [
          "1.0",
          "1.1"
        ]
      },
      "operation": {
        "enum": [
          "generate",
          "edit"
        ],
        "default": "generate"
      },
      "asset_type": {
        "enum": [
          "card",
          "portrait"
        ],
        "default": "card"
      },
      "character": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "era": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "clothing": {
            "type": "string"
          },
          "pose": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "biography": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "provided",
                  "auto",
                  "omit"
                ]
              },
              "text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "required": [
              "mode"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "provided"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preset": {
            "enum": [
              "historical-strategy",
              "stzb-inspired",
              "custom"
            ],
            "default": "historical-strategy"
          },
          "description": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "preset": {
                  "const": "custom"
                }
              },
              "required": [
                "preset"
              ]
            },
            "then": {
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "reference_images": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "enum": [
                "layout",
                "art_style",
                "character_identity",
                "edit_target"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "role"
          ]
        },
        "default": []
      },
      "card": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stars": {
            "type": "integer",
            "minimum": 0,
            "default": 5
          },
          "faction_label": {
            "type": "string"
          },
          "troop_type": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "ability": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "grade": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "concept_label": {
            "type": "string",
            "default": "概念设计"
          },
          "show_biography": {
            "type": "boolean",
            "default": true
          },
          "biography_label": {
            "type": "string",
            "default": "人物小传"
          }
        }
      },
      "extra_text": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "edit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change_request": {
            "type": "string",
            "minLength": 1
          },
          "preserve": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "change_request"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "type": "string",
            "pattern": "^[1-9][0-9]*:[1-9][0-9]*$",
            "default": "2:3"
          },
          "transparent_background": {
            "type": "boolean",
            "default": false
          },
          "preferred_format": {
            "enum": [
              "png",
              "webp"
            ],
            "default": "png"
          },
          "directory": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "revision_limit": {
            "type": "integer",
            "minimum": 0,
            "default": 2
          }
        }
      }
    },
    "required": [
      "schema_version",
      "character"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "operation": {
              "const": "edit"
            }
          },
          "required": [
            "operation"
          ]
        },
        "then": {
          "required": [
            "edit",
            "reference_images"
          ],
          "properties": {
            "reference_images": {
              "contains": {
                "properties": {
                  "role": {
                    "const": "edit_target"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "asset_type": {
              "const": "portrait"
            }
          },
          "required": [
            "asset_type"
          ]
        },
        "then": {
          "not": {
            "required": [
              "card"
            ]
          }
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "General character illustration / card result",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "enum": [
          "1.0",
          "1.1"
        ]
      },
      "status": {
        "enum": [
          "prepared",
          "generated",
          "needs_input",
          "tool_unavailable",
          "review_required",
          "error"
        ]
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "image",
                "prompt",
                "manifest"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "uri"
          ]
        }
      },
      "prompt": {
        "type": "string"
      },
      "provider": {
        "type": "string"
      },
      "revision_count": {
        "type": "integer",
        "minimum": 0
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reference_status": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "viewed",
                "uninspected",
                "missing"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "status"
          ]
        }
      },
      "review": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_checked"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "check",
            "status"
          ]
        }
      },
      "message": {
        "type": "string"
      },
      "next_action": {
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "status",
      "artifacts",
      "review"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "generated"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "artifacts": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "image"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "review": {
              "minItems": 1,
              "items": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    ]
  }
}
